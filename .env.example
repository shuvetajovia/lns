# Public browser configuration only. Never put a service-role key or payment secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Must match a Supabase Authentication allowed redirect URL. Use the HTTPS website
# for the desktop app's email recovery links; file:// callbacks are unsupported.
VITE_SITE_URL=https://your-store.example/
# Optional. Missing social accounts are hidden instead of linking to generic sites.
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
